        <mxCell id="P4_GET_INPUTS" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;ESP32 Tiếp nhận dữ liệu cảm biến &amp;amp; trạng thái hệ thống:&lt;/b&gt;&lt;br/&gt; • Trạng thái tương tác giọng nói &amp;amp; AI Chatbot (Phân hệ 5)&lt;br/&gt; • Cảm biến gia tốc rung lắc / góc nghiêng chậu cây MPU6050 (Phân hệ 2)&lt;br/&gt; • Độ ẩm đất (Soil ADC) &amp;amp; Mực nước bình chứa (Phân hệ 2 &amp;amp; 3)&lt;br/&gt; • Cường độ ánh sáng (Lux) &amp;amp; Nhiệt độ môi trường (Phân hệ 2)" vertex="1">
          <mxGeometry height="90" width="560" x="185" y="1910" as="geometry" />
        </mxCell>
        <mxCell id="P4_DEC_VOICE" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Ưu tiên 1: Có sự kiện tương tác&lt;br/&gt;giọng nói / AI Chatbot không?&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="360" x="285" y="2023" as="geometry" />
        </mxCell>
        <mxCell id="P4_VOICE_EMO" parent="1" style="rounded=1;arcSize=8;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;BIỂU CẢM TƯƠNG TÁC GIỌNG NÓI &amp;amp; AI:&lt;/b&gt;&lt;br/&gt; • Khi Mic thu âm: Biểu cảm &lt;b&gt;Đang lắng nghe (o_o)&lt;/b&gt;&lt;br/&gt; • Khi AI Cloud xử lý: Biểu cảm &lt;b&gt;Đang suy nghĩ (-_-)&lt;/b&gt;&lt;br/&gt; • Khi Loa phát trả lời: Biểu cảm &lt;b&gt;Đang nói chuyện (^o^)&lt;/b&gt;&lt;br/&gt; • Khi hoàn thành: Tự động trở về biểu cảm theo cây" vertex="1">
          <mxGeometry height="105" width="305" x="555" y="2105" as="geometry" />
        </mxCell>
        <mxCell id="P4_DEC_TILT" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Ưu tiên 2: Phát hiện chậu cây&lt;br/&gt;nghiêng / rung lắc bất thường?&lt;br/&gt;(MPU6050: a &amp;gt; 1.5g / tilt &amp;gt; 30°)&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="380" x="175" y="2115" as="geometry" />
        </mxCell>
        <mxCell id="P4_TILT_EMO" parent="1" style="rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;Biểu cảm NGẠC NHIÊN / BÁO ĐỘNG (O_O)&lt;/b&gt;&lt;br/&gt; Phản hồi tức thì khi chậu cây bị tác động lực, va chạm hoặc di chuyển" vertex="1">
          <mxGeometry height="65" width="320" x="30" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="P4_DEC_SOIL" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Ưu tiên 3: Đất có đủ độ ẩm không?&lt;br/&gt;(ADC &amp;gt; 1100 &amp;amp; Bình còn nước?)&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="380" x="365" y="2240" as="geometry" />
        </mxCell>
        <mxCell id="P4_DEC_ENV" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Ưu tiên 4: Nhiệt độ &amp;amp; Ánh sáng&lt;br/&gt;có phù hợp cho sinh trưởng?&lt;br/&gt;(18°C ≤ T ≤ 32°C &amp;amp; Đủ sáng?)&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="380" x="250" y="2367.5" as="geometry" />
        </mxCell>
        <mxCell id="P4_ENV_BAD" parent="1" style="rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;Biểu cảm KHÓ CHỊU / MỆT MỎI (-.- hoặc ~_~)&lt;/b&gt;&lt;br/&gt; Mắt ngái ngủ, ủ rũ do thời tiết quá nóng/lạnh hoặc thiếu ánh sáng" vertex="1">
          <mxGeometry height="70" width="330" x="70" y="2450" as="geometry" />
        </mxCell>
        <mxCell id="P4_ENV_GOOD" parent="1" style="rounded=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;Biểu cảm VUI VẺ / HẠNH PHÚC (^ ^ hoặc (^_^)/)&lt;/b&gt;&lt;br/&gt; Hai mắt cong tròn tươi vui, cây phát triển trong môi trường tối ưu" vertex="1">
          <mxGeometry height="70" width="315" x="545" y="2450" as="geometry" />
        </mxCell>
        <mxCell id="P4_DUAL_RENDER" parent="1" style="rounded=1;arcSize=6;fillColor=#6B21A8;strokeColor=#581C87;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=11.5;shadow=1;" value="&lt;b&gt;THUẬT TOÁN ĐỒNG BỘ HAI MÀN HÌNH OLED 0.96&amp;quot;:&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;OLED 1 (I2C 0x3C):&lt;/b&gt; Render Frame đồ họa chuyên biệt cho &lt;b&gt;MẮT TRÁI&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;OLED 2 (I2C 0x3D):&lt;/b&gt; Render Frame đồ họa chuyên biệt cho &lt;b&gt;MẮT PHẢI&lt;/b&gt;&lt;br/&gt; • &lt;i&gt;Nguyên tắc thiết kế:&lt;/i&gt; Hai mắt đồng bộ biểu cảm, mỗi màn hình chỉ đảm nhiệm một mắt riêng biệt (Tuyệt đối không hiển thị nguyên khuôn mặt trên từng màn hình)&lt;br/&gt; • Kèm thuật toán tự động chớp mắt tự nhiên (Blink Animation chu kỳ 3 - 5 giây ngẫu nhiên)" vertex="1">
          <mxGeometry height="125" width="700" x="115" y="2545" as="geometry" />
        </mxCell>
        <mxCell id="P4_UPDATE_DISP" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Gửi lệnh I2C display() cập nhật đồng thời cả hai màn hình OLED&lt;/b&gt;&lt;br/&gt;Duy trì biểu cảm hiển thị và liên tục cập nhật theo trạng thái mới nhất" vertex="1">
          <mxGeometry height="55" width="540" x="195" y="2690" as="geometry" />
        </mxCell>
        <mxCell id="P4_EMO_TABLE" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;" value="&lt;b&gt;BẢNG DANH MỤC BIỂU CẢM HAI MẮT OLED THỰC TẾ:&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;Vui vẻ, tươi tốt:&lt;/b&gt; ^ ^  hoặc  (^_^)/   |   • &lt;b&gt;Buồn bã, thiếu nước:&lt;/b&gt; T_T&lt;br/&gt; • &lt;b&gt;Khát nước trầm trọng:&lt;/b&gt; &amp;gt;&amp;lt;            |   • &lt;b&gt;Ngạc nhiên, bị rung lắc chậu:&lt;/b&gt; O_O&lt;br/&gt; • &lt;b&gt;Đang lắng nghe:&lt;/b&gt; o_o                  |   • &lt;b&gt;Đang suy nghĩ (AI xử lý):&lt;/b&gt; -_-&lt;br/&gt; • &lt;b&gt;Đang nói chuyện (Loa phát):&lt;/b&gt; ^o^      |   • &lt;b&gt;Ngái ngủ, mệt mỏi:&lt;/b&gt; -.-  hoặc  ~_~" vertex="1">
          <mxGeometry height="130" width="640" x="145" y="2765" as="geometry" />
        </mxCell>
        <mxCell id="edge_45" edge="1" parent="1" source="P4_START" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.8;fontColor=#1E293B;fontSize=11;" target="P4_GET_INPUTS" value="">
          <mxGeometry relative="1" as="geometry" />
