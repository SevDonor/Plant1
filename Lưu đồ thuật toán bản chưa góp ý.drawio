        <mxCell id="edge_7" edge="1" parent="1" source="P1_CHECK_HW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#B91C1C;fontStyle=1;fontSize=11;exitX=1;exitDx=0;exitDy=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryDx=0;entryDy=0;entryY=0;entryDx=0;entryDy=0;" target="P1_HW_ERR" value="NO (Lỗi)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_8" edge="1" parent="1" source="P1_CHECK_HW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontColor=#15803D;fontStyle=1;fontSize=11;exitX=0.5;exitDx=0;exitDy=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryDx=0;entryDy=0;entryY=0;entryDx=0;entryDy=0;" target="P1_INIT_WIFI" value="YES (Bình thường)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_9" edge="1" parent="1" source="P1_HW_ERR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.8;fontColor=#1E293B;fontSize=11;exitX=0.5;exitDx=0;exitDy=0;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryDx=0;entryDy=0;entryY=0;entryDx=0;entryDy=0;" target="P1_INIT_WIFI" value="Tiếp tục giám sát">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
