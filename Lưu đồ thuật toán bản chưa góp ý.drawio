        <mxCell id="P5_DEC_INTERNET" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Có kết nối Internet&lt;br/&gt;đến Cloud Server không?&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="360" x="1200" y="2105" as="geometry" />
        </mxCell>
        <mxCell id="P5_OFFLINE_VOICE" parent="1" style="rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;XỬ LÝ NGOẠI LỆ MẤT MẠNG (OFFLINE VOICE):&lt;/b&gt;&lt;br/&gt; • Tạm ngừng tính năng nhận dạng giọng nói AI trực tuyến&lt;br/&gt; • Loa phát âm thanh có sẵn: &lt;i&gt;&amp;quot;Mất mạng rồi, cây vẫn tự động tưới nước nhé!&amp;quot;&lt;/i&gt;&lt;br/&gt; • Đưa OLED trở lại biểu cảm cơ bản theo trạng thái cây" vertex="1">
          <mxGeometry height="95" width="320" x="945" y="2205" as="geometry" />
        </mxCell>
        <mxCell id="P5_ONLINE_STT" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A5B4FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Speech-to-Text (STT) qua Cloud API:&lt;/b&gt;&lt;br/&gt; Stream đoạn âm thanh lên Cloud ➔ Chuyển đổi giọng nói thành văn bản&lt;br/&gt; Đồng thời OLED 2 mắt chuyển sang biểu cảm &lt;b&gt;Đang suy nghĩ (-_-)&lt;/b&gt;" vertex="1">
          <mxGeometry height="65" width="560" x="1270" y="2213" as="geometry" />
        </mxCell>
        <mxCell id="P5_INTENT_SPLIT" parent="1" style="rounded=1;arcSize=6;fillColor=#3730A3;strokeColor=#312E81;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=11.5;shadow=1;" value="&lt;b&gt;PHÂN TÍCH Ý ĐỊNH NGƯỜI DÙNG (INTENT RECOGNITION &amp;amp; NLP):&lt;/b&gt;&lt;br/&gt; Bộ phân tích ngôn ngữ tự nhiên phân loại câu nói vào 1 trong 3 nhóm chức năng:" vertex="1">
          <mxGeometry height="60" width="680" x="1040" y="2305" as="geometry" />
        </mxCell>
        <mxCell id="P5_INTENT_1" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A5B4FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;NHÓM 1: HỎI THĂM TÌNH TRẠNG CÂY&lt;/b&gt;&lt;br/&gt; • Ví dụ câu hỏi:&lt;br/&gt;   &lt;i&gt;&amp;quot;Cây có khỏe không?&amp;quot;&lt;/i&gt;&lt;br/&gt;   &lt;i&gt;&amp;quot;Cây có cần tưới nước không?&amp;quot;&lt;/i&gt;&lt;br/&gt;   &lt;i&gt;&amp;quot;Nhiệt độ hiện tại thế nào?&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Xử lý:&lt;/b&gt; ESP32 trích xuất dữ liệu cảm biến mới nhất (Đất, Nước, Nhiệt độ, Ánh sáng, AQI)&lt;br/&gt; • Gửi ngữ cảnh (Context) cho AI Chatbot" vertex="1">
          <mxGeometry height="160" width="275" x="945" y="2390" as="geometry" />
        </mxCell>
        <mxCell id="P5_INTENT_2" parent="1" style="rounded=1;arcSize=8;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#3730A3;align=center;verticalAlign=middle;html=1;fontSize=11.5;fontStyle=1;" value="&lt;b&gt;NHÓM 2: ĐIỀU KHIỂN THIẾT BỊ&lt;/b&gt;&lt;br/&gt; • Ví dụ khẩu lệnh:&lt;br/&gt;   &lt;i&gt;&amp;quot;Tưới nước cho cây.&amp;quot;&lt;/i&gt;&lt;br/&gt;   &lt;i&gt;&amp;quot;Ngừng tưới nước.&amp;quot;&lt;/i&gt;&lt;br/&gt;   &lt;i&gt;&amp;quot;Bật chế độ tự động.&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Quy tắc an toàn:&lt;/b&gt;&lt;br/&gt;   - Lệnh ngừng tưới: &lt;b&gt;Ưu tiên ngắt bơm ngay!&lt;/b&gt;&lt;br/&gt;   - Lệnh tưới: Kiểm tra mực nước &amp;amp; an toàn trước khi kích hoạt xung 3s có giám sát.&lt;br/&gt; ➔ Gửi tín hiệu sang &lt;b&gt;PHÂN HỆ 3&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="285" x="1235" y="2390" as="geometry" />
        </mxCell>
        <mxCell id="P5_INTENT_3" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A5B4FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;NHÓM 3: TRÒ CHUYỆN VỚI CÂY&lt;/b&gt;&lt;br/&gt; • Ví dụ trò chuyện:&lt;br/&gt;   &lt;i&gt;&amp;quot;Bạn đang làm gì vậy?&amp;quot;&lt;/i&gt;&lt;br/&gt;   &lt;i&gt;&amp;quot;Bạn có vui không?&amp;quot;&lt;/i&gt;&lt;br/&gt;   &lt;i&gt;&amp;quot;Hôm nay bạn thế nào?&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Xử lý:&lt;/b&gt; Gửi câu hỏi + Dữ liệu cảm biến thực tế của cây vào mô hình ngôn ngữ lớn (AI LLM)&lt;br/&gt; • AI tạo câu trả lời tự nhiên theo tính cách riêng" vertex="1">
          <mxGeometry height="160" width="280" x="1535" y="2390" as="geometry" />
        </mxCell>
        <mxCell id="P5_AI_PERSONALITY" parent="1" style="rounded=1;arcSize=6;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#1E1B4B;align=left;spacingLeft=15;verticalAlign=middle;html=1;fontSize=11.5;shadow=0;" value="&lt;b&gt;TẠO PHẢN HỒI AI CHATBOT VỚI TÍNH CÁCH ĐỘC ĐÁO CỦA CÂY:&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;Khi được tưới nước:&lt;/b&gt; &lt;i&gt;&amp;quot;Aaaa, mát quá! Cảm ơn bạn nha!&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Khi đất khô:&lt;/b&gt; &lt;i&gt;&amp;quot;Mình khát nước lắm rồi đó!&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Khi thiếu ánh sáng:&lt;/b&gt; &lt;i&gt;&amp;quot;Hôm nay mình hơi thiếu nắng!&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Khi trời quá nóng:&lt;/b&gt; &lt;i&gt;&amp;quot;Nóng quá, cho mình nghỉ ngơi chút đi!&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Khi người dùng lắc chậu:&lt;/b&gt; &lt;i&gt;&amp;quot;Á! Bạn làm mình chóng mặt rồi!&amp;quot;&lt;/i&gt;&lt;br/&gt; • &lt;b&gt;Khi không có vấn đề:&lt;/b&gt; &lt;i&gt;&amp;quot;Hôm nay mình khỏe re luôn!&amp;quot;&lt;/i&gt;&lt;br/&gt; &lt;i&gt;(Nguyên tắc bắt buộc: AI trả lời dựa trên dữ liệu cảm biến thực tế, không tự bịa ra các chỉ số)&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="700" x="1030" y="2575" as="geometry" />
        </mxCell>
        <mxCell id="P5_TTS_ENGINE" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A5B4FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Cloud Text-to-Speech (TTS Engine):&lt;/b&gt;&lt;br/&gt; Chuyển đổi văn bản câu trả lời của AI thành luồng dữ liệu âm thanh giọng nói (Audio Stream)" vertex="1">
          <mxGeometry height="55" width="560" x="1100" y="2740" as="geometry" />
        </mxCell>
        <mxCell id="P5_SPEAKER_PLAY" parent="1" style="rounded=1;arcSize=8;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#3730A3;align=center;verticalAlign=middle;html=1;fontSize=11.5;fontStyle=1;" value="&lt;b&gt;ESP32 Nhận Audio Stream &amp;amp; Phát qua Loa (Speaker):&lt;/b&gt;&lt;br/&gt; Đồng thời điều khiển OLED 2 mắt chuyển sang biểu cảm &lt;b&gt;Đang nói chuyện (^o^)&lt;/b&gt; linh động" vertex="1">
          <mxGeometry height="60" width="600" x="1080" y="2820" as="geometry" />
        </mxCell>
        <mxCell id="P5_END_VOICE" parent="1" style="rounded=1;arcSize=50;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=12;shadow=1;" value="&lt;b&gt;Kết thúc tương tác giọng nói:&lt;/b&gt;&lt;br/&gt; OLED tự động hoàn trả quyền điều khiển về biểu cảm theo trạng thái thực tế của cây trồng" vertex="1">
          <mxGeometry height="55" width="540" x="1110" y="2905" as="geometry" />
        </mxCell>
