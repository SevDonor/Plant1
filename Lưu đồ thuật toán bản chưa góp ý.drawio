        <mxCell id="P3_DEC_RECHECK_1100" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Giá trị ADC đọc lại&lt;br/&gt;có &amp;gt; 1100 không?&lt;/b&gt;" vertex="1">
