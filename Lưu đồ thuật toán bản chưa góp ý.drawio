        <mxCell id="P3_START_EVAL" parent="1" style="rounded=1;arcSize=50;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=12;shadow=1;" value="&lt;b&gt;BẮT ĐẦU KIỂM TRA ĐỘ ẨM ĐẤT&lt;/b&gt;&lt;br/&gt;(Kích hoạt bởi Vòng lặp định kỳ hoặc Lệnh tưới từ AI Voice / App)" vertex="1">
          <mxGeometry height="55" width="500" x="2090" y="235" as="geometry" />
        </mxCell>
        <mxCell id="P3_READ_SOIL_ADC" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;ESP32 Đọc giá trị ADC từ cảm biến độ ẩm đất&lt;/b&gt;&lt;br/&gt;(Nhận dữ liệu đã qua lọc từ Phân hệ 2: Soil Moisture ADC)" vertex="1">
          <mxGeometry height="55" width="520" x="2080" y="315" as="geometry" />
        </mxCell>
        <mxCell id="P3_DEC_1100" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Giá trị ADC có&lt;br/&gt;lớn hơn 1100 không?&lt;br/&gt;(ADC &amp;gt; 1100 ?)&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="380" x="2130" y="400" as="geometry" />
        </mxCell>
        <mxCell id="P3_YES_STOP_PUMP" parent="1" style="rounded=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;NHÁNH YES: ADC &amp;gt; 1100 (ĐỦ NƯỚC)&lt;/b&gt;&lt;br/&gt; • Xác định đất đã đạt ngưỡng độ ẩm yêu cầu theo quy ước&lt;br/&gt; • Đảm bảo Tắt bơm nước hoàn toàn (Relay = LOW)" vertex="1">
          <mxGeometry height="75" width="335" x="2445" y="505" as="geometry" />
        </mxCell>
        <mxCell id="P3_YES_UPDATE_STATE" parent="1" style="rounded=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;Cập nhật trạng thái hệ thống:&lt;/b&gt;&lt;br/&gt; • Trạng thái cây: &lt;b&gt;ĐỦ NƯỚC (SUFFICIENT)&lt;/b&gt;&lt;br/&gt; • Reset biến đếm chu kỳ: &lt;code&gt;watering_cycles = 0&lt;/code&gt;&lt;br/&gt; • Kích hoạt OLED hiển thị biểu cảm &lt;b&gt;VUI VẺ (^ ^)&lt;/b&gt;&lt;br/&gt; • Gửi trạng thái &amp;quot;Đủ nước / Bơm tắt&amp;quot; lên Cloud &amp;amp; App" vertex="1">
          <mxGeometry height="95" width="335" x="2445" y="600" as="geometry" />
        </mxCell>
        <mxCell id="P3_YES_WAIT_CYCLE" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Chờ chu kỳ đo tiếp theo&lt;/b&gt;&lt;br/&gt;(Chu kỳ nghỉ định kỳ 15 - 30 phút hoặc chu kỳ đọc cảm biến)" vertex="1">
          <mxGeometry height="55" width="335" x="2445" y="715" as="geometry" />
        </mxCell>
        <mxCell id="P3_DEC_MAX_CYCLES" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Số chu kỳ tưới liên tiếp&lt;br/&gt;≥ GIỚI HẠN TỐI ĐA?&lt;br/&gt;(cycles ≥ MAX_CYCLES = 5 ?)&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="360" x="2080" y="505" as="geometry" />
        </mxCell>
        <mxCell id="P3_FAILSAFE_ALERT" parent="1" style="rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;CẢNH BÁO AN TOÀN - DỪNG BƠM KHẨN CẤP:&lt;/b&gt;&lt;br/&gt; • Khóa bơm nước ngay lập tức (Bơm = OFF)!&lt;br/&gt; • Bật cờ cảnh báo lỗi: &lt;code&gt;WATERING_FAULT_ERROR&lt;/code&gt;&lt;br/&gt;   (Tránh lỗi cảm biến tuột khỏi đất, đứt dây gây tưới ngập tràn)&lt;br/&gt; • OLED nhấp nháy biểu tượng cảnh báo lỗi [!]&lt;br/&gt; • Loa phát âm thanh cảnh báo lỗi tưới nước&lt;br/&gt; • Gửi thông báo khẩn cấp lên Cloud Server và Mobile App&lt;br/&gt; • Tạm dừng bơm cho đến khi người dùng kiểm tra &amp;amp; Reset" vertex="1">
          <mxGeometry height="145" width="360" x="1905" y="610" as="geometry" />
        </mxCell>
        <mxCell id="P3_DEC_WATER_LEVEL" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Bình chứa còn đủ nước&lt;br/&gt;để tưới không?&lt;br/&gt;(Water Level ≥ Ngưỡng an toàn ?)&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="380" x="2240" y="755" as="geometry" />
        </mxCell>
        <mxCell id="P3_NO_WATER_ALERT" parent="1" style="rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;NHÁNH NO: BÌNH CHỨA HẾT NƯỚC&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;KHÔNG KÍCH HOẠT BƠM!&lt;/b&gt; Đảm bảo bơm ở trạng thái OFF (LOW)&lt;br/&gt; • OLED hiển thị biểu cảm &lt;b&gt;BUỒN / KHÁT NƯỚC (T_T hoặc &amp;gt;&amp;lt;)&lt;/b&gt;&lt;br/&gt; • Loa phát thông báo giọng nói:&lt;br/&gt;   &lt;i&gt;&amp;quot;Hết nước rồi! Bạn bổ sung nước cho mình nhé!&amp;quot;&lt;/i&gt;&lt;br/&gt; • Gửi cảnh báo khẩn cấp lên Cloud Server và Mobile App&lt;br/&gt; • Chờ người dùng châm thêm nước &amp;amp; định kỳ đọc lại cảm biến" vertex="1">
          <mxGeometry height="135" width="360" x="1900" y="800" as="geometry" />
        </mxCell>
        <mxCell id="P3_INC_CYCLE" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;NHÁNH YES: Bình đủ nước &amp;amp; Sẵn sàng tưới&lt;/b&gt;&lt;br/&gt; • Tăng biến đếm: &lt;code&gt;watering_cycles = watering_cycles + 1&lt;/code&gt;&lt;br/&gt; • Kiểm tra trạng thái an toàn relay &amp;amp; nguồn điện cấp" vertex="1">
          <mxGeometry height="60" width="480" x="2300" y="860" as="geometry" />
        </mxCell>
        <mxCell id="P3_PUMP_ON" parent="1" style="rounded=1;arcSize=8;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#3730A3;align=center;verticalAlign=middle;html=1;fontSize=11.5;fontStyle=1;" value="&lt;b&gt;BẬT BƠM MINI 5V (Relay/MOSFET = HIGH)&lt;/b&gt;&lt;br/&gt; Bắt đầu bộ đếm thời gian Timer chính xác 3 giây" vertex="1">
          <mxGeometry height="60" width="480" x="2120" y="940" as="geometry" />
        </mxCell>
        <mxCell id="P3_PUMP_RUN_3S" parent="1" style="rounded=1;arcSize=8;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#3730A3;align=center;verticalAlign=middle;html=1;fontSize=11.5;fontStyle=1;" value="&lt;b&gt;BƠM HOẠT ĐỘNG TRONG ĐÚNG 3 GIÂY&lt;/b&gt;&lt;br/&gt; (Bơm nước theo từng chu kỳ định lượng 3s, tuyệt đối không chạy liên tục trong vòng lặp)" vertex="1">
          <mxGeometry height="60" width="520" x="2080" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="P3_PUMP_OFF" parent="1" style="rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;HẾT 3 GIÂY: TẮT BƠM HOÀN TOÀN!&lt;/b&gt;&lt;br/&gt; (Relay/MOSFET = LOW - Ngắt dứt điểm dòng điện cấp cho bơm)" vertex="1">
          <mxGeometry height="60" width="480" x="2080" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="P3_WAIT_SOAK" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;CHỜ KHOẢNG 1 – 2 GIÂY TRỄ NGẤM NƯỚC:&lt;/b&gt;&lt;br/&gt; • Để nước tưới ngấm đều vào các mao quản đất và vùng rễ cây&lt;br/&gt; • Để điện áp cảm biến độ ẩm đất ADC ổn định, tránh sai số do nước bề mặt" vertex="1">
          <mxGeometry height="70" width="540" x="2030" y="1230" as="geometry" />
        </mxCell>
