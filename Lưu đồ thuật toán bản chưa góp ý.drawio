        </mxCell>
        <mxCell id="P6_HEADER" parent="1" style="rounded=1;arcSize=4;fillColor=#0369A1;strokeColor=#075985;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;html=1;" value="PHÂN HỆ 6: KẾT NỐI CLOUD VÀ MOBILE APP (IOT CLOUD &amp;amp; MOBILE APP INTEGRATION)" vertex="1">
          <mxGeometry height="45" width="920" x="1880" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="P6_COLLECT_DATA" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7DD3FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;ESP32 Thu thập toàn bộ dữ liệu cảm biến &amp;amp; trạng thái hệ thống&lt;/b&gt;&lt;br/&gt;(Lấy từ Phân hệ 2: Cảm biến | Phân hệ 3: Trạng thái Bơm | Phân hệ 4: Biểu cảm)" vertex="1">
          <mxGeometry height="55" width="540" x="2070" y="1835" as="geometry" />
        </mxCell>
        <mxCell id="P6_JSON_PACKET" parent="1" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0369A1;align=left;spacingLeft=15;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;Đóng gói dữ liệu thành gói tin JSON chuẩn IoT:&lt;/b&gt;&lt;br&gt; • &lt;b&gt;Soil Moisture ADC&lt;/b&gt; (Độ ẩm đất ADC &amp;amp; quy đổi %)&lt;br&gt; • &lt;b&gt;Light Intensity&lt;/b&gt; (Cường độ ánh sáng Lux)&lt;br&gt;&lt;br&gt; • &lt;b&gt;Temperature &amp;amp; Pressure&lt;/b&gt; (Nhiệt độ °C &amp;amp; Áp suất hPa)&lt;br&gt; • &lt;b&gt;Acceleration X, Y, Z&lt;/b&gt; (Gia tốc &amp;amp; Góc nghiêng Tilt)&lt;br&gt; • &lt;b&gt;Water Level&lt;/b&gt; (Mức nước còn lại trong bình)&lt;br&gt; • &lt;b&gt;Pump Status&lt;/b&gt; (Bơm ON/OFF, Chu kỳ tưới hiện tại)&lt;br&gt; • &lt;b&gt;Plant Emotion&lt;/b&gt; (Biểu cảm hai mắt OLED hiện tại)&lt;br&gt; • &lt;b&gt;System Status&lt;/b&gt; (Mã lỗi, Mức sóng Wi-Fi RSSI, Uptime)&lt;br&gt; • &lt;b&gt;Timestamp&lt;/b&gt; (Thời gian thực đồng bộ từ NTP)" vertex="1">
          <mxGeometry height="180" width="640" x="2020" y="1910" as="geometry" />
        </mxCell>
        <mxCell id="P6_DEC_WIFI" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Wi-Fi có đang&lt;br/&gt;kết nối không?&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="360" x="2160" y="2115" as="geometry" />
        </mxCell>
        <mxCell id="P6_OFFLINE_BUFFER" parent="1" style="rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;NHÁNH NO: MẤT KẾT NỐI MẠNG WI-FI&lt;/b&gt;&lt;br/&gt; • Lưu tạm gói tin JSON quan trọng vào bộ nhớ đệm (Flash/RAM Buffer)&lt;br/&gt; • Tiếp tục duy trì 100% điều khiển tự động tại chỗ trên ESP32&lt;br/&gt; • Định kỳ 30s thử tái kết nối Wi-Fi ngầm (Non-blocking reconnect)" vertex="1">
          <mxGeometry height="95" width="335" x="2445" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="P6_SYNC_BACKLOG" parent="1" style="rounded=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;Đồng bộ dữ liệu bù khi có mạng:&lt;/b&gt;&lt;br/&gt; Khi Wi-Fi kết nối thành công, tự động đẩy toàn bộ dữ liệu lịch sử còn thiếu lên Cloud Server" vertex="1">
          <mxGeometry height="70" width="335" x="2445" y="2335" as="geometry" />
        </mxCell>
        <mxCell id="P6_MQTT_SEND" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7DD3FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;NHÁNH YES: ESP32 gửi dữ liệu lên Cloud Server&lt;/b&gt;&lt;br/&gt; Gửi bản tin JSON qua giao thức &lt;b&gt;MQTT Publish&lt;/b&gt; (Topic: &lt;code&gt;plant/telemetry&lt;/code&gt;) hoặc &lt;b&gt;HTTPS POST&lt;/b&gt;" vertex="1">
          <mxGeometry height="65" width="540" x="1900" y="2278" as="geometry" />
        </mxCell>
        <mxCell id="P6_CLOUD_PLATFORM" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;rounded=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;" value="&lt;b&gt;Cloud Server &amp;amp; Database tiếp nhận và xử lý dữ liệu:&lt;/b&gt;&lt;br/&gt; • Lưu trữ toàn bộ dữ liệu cảm biến vào &lt;b&gt;Database&lt;/b&gt; (Firebase / InfluxDB Time-Series)&lt;br/&gt; • Cập nhật bản sao trạng thái cây trồng theo thời gian thực (Device Shadow / Digital Twin)&lt;br/&gt; • Phân tích dữ liệu &amp;amp; Kích hoạt cảnh báo tự động khi phát hiện bất thường (Hết nước, nhiệt độ quá cao)" vertex="1">
          <mxGeometry height="85" width="640" x="2000" y="2448" as="geometry" />
        </mxCell>
        <mxCell id="P6_PUSH_MOBILE" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7DD3FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Đẩy dữ liệu mới nhất đến Mobile Application:&lt;/b&gt;&lt;br/&gt; Gửi dữ liệu thời gian thực qua giao thức &lt;b&gt;WebSocket&lt;/b&gt;, &lt;b&gt;MQTT Broker&lt;/b&gt; hoặc &lt;b&gt;Firebase FCM Notification&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="580" x="2030" y="2575" as="geometry" />
        </mxCell>
        <mxCell id="P6_MOBILE_APP_UI" parent="1" style="rounded=1;arcSize=6;fillColor=#0369A1;strokeColor=#075985;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=11.5;shadow=1;" value="&lt;b&gt;GIAO DIỆN MOBILE APPLICATION (NGƯỜI DÙNG GIÁM SÁT &amp;amp; ĐIỀU KHIỂN TỪ XA):&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;Trang Home:&lt;/b&gt; Trạng thái tổng quan, Avatar khuôn mặt biểu cảm đồng bộ 1:1 với 2 màn hình OLED&lt;br/&gt; • &lt;b&gt;Trang Giám sát:&lt;/b&gt; Đồ thị trực quan thời gian thực độ ẩm đất, nhiệt độ, ánh sáng, chất lượng không khí&lt;br/&gt; • &lt;b&gt;Trang Điều khiển:&lt;/b&gt; Nút tưới nước thủ công an toàn, nút dừng tưới khẩn cấp, cài đặt ngưỡng ADC tự động&lt;br/&gt; • &lt;b&gt;Trang AI Chatbot:&lt;/b&gt; Khung chat văn bản và giọng nói trực tiếp với AI cây trồng mọi lúc mọi nơi&lt;br/&gt; • &lt;b&gt;Trung tâm cảnh báo:&lt;/b&gt; Nhận thông báo đẩy (Push Notification) khi hết nước, cảm biến lỗi hoặc chậu bị lắc" vertex="1">
          <mxGeometry height="140" width="680" x="1980" y="2670" as="geometry" />
        </mxCell>
        <mxCell id="P6_DOWNLINK_CMD" parent="1" style="rounded=1;arcSize=8;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#3730A3;align=center;verticalAlign=middle;html=1;fontSize=11.5;fontStyle=1;" value="&lt;b&gt;KÊNH ĐIỀU KHIỂN XUỐNG TỪ XA (DOWNLINK COMMAND):&lt;/b&gt;&lt;br/&gt; Người dùng gửi lệnh từ Mobile App (Lệnh tưới thủ công, dừng khẩn cấp, đổi ngưỡng)&lt;br/&gt; ➔ Cloud truyền lệnh xuống ESP32 qua MQTT ➔ ESP32 kiểm tra an toàn &amp;amp; thực thi tại &lt;b&gt;PHÂN HỆ 3&lt;/b&gt;" vertex="1">
          <mxGeometry height="75" width="620" x="2010" y="2850" as="geometry" />
        </mxCell>
        <mxCell id="P6_CYCLE_WAIT" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7DD3FC;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Hoàn thành chu trình truyền thông IoT&lt;/b&gt;&lt;br/&gt;Chờ chu kỳ đóng gói và gửi dữ liệu tiếp theo (Chu kỳ T = 5 - 15 giây)" vertex="1">
          <mxGeometry height="55" width="480" x="2070" y="2960" as="geometry" />
        </mxCell>
