          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_11" edge="1" parent="1" source="P1_WIFI_DEC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontColor=#15803D;fontStyle=1;fontSize=11;exitX=0;exitDx=0;exitDy=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryDx=0;entryDy=0;entryY=0;entryDx=0;entryDy=0;" target="P1_WIFI_YES" value="YES (Thành công)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_12" edge="1" parent="1" source="P1_WIFI_DEC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#B91C1C;fontStyle=1;fontSize=11;exitX=1;exitDx=0;exitDy=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryDx=0;entryDy=0;entryY=0;entryDx=0;entryDy=0;" target="P1_WIFI_NO" value="NO (Mất mạng)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_13" edge="1" parent="1" source="P1_WIFI_YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.8;fontColor=#1E293B;fontSize=11;exitX=0.5;exitDx=0;exitDy=0;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryDx=0;entryDy=0;entryY=0;entryDx=0;entryDy=0;" target="P1_INIT_DONE" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_14" edge="1" parent="1" source="P1_WIFI_NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.8;fontColor=#1E293B;fontSize=11;exitX=0.5;exitDx=0;exitDy=0;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryDx=0;entryDy=0;entryY=0;entryDx=0;entryDy=0;" target="P1_INIT_DONE" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_15" edge="1" parent="1" source="P1_INIT_DONE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.8;fontColor=#1E293B;fontSize=11;" target="P1_GOTO_LOOP" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P2_CONTAINER" parent="1" style="rounded=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;dashed=0;html=1;shadow=0;" value="" vertex="1">
          <mxGeometry height="1550" width="920" x="940" y="200" as="geometry" />
        </mxCell>
        <mxCell id="P2_HEADER" parent="1" style="rounded=1;arcSize=4;fillColor=#0F766E;strokeColor=#115E59;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;html=1;" value="PHÂN HỆ 2: THU THẬP VÀ XỬ LÝ DỮ LIỆU CẢM BIẾN (DATA ACQUISITION &amp;amp; PROCESSING)" vertex="1">
          <mxGeometry height="45" width="920" x="920" y="170" as="geometry" />
        </mxCell>
        <mxCell id="P2_LOOP_ENTRY" parent="1" style="rounded=1;arcSize=50;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=12;shadow=1;" value="&lt;b&gt;Bắt đầu Vòng lặp đọc dữ liệu cảm biến định kỳ&lt;/b&gt;&lt;br/&gt;(ESP32 FreeRTOS Task chu kỳ T = 2 - 5 giây)" vertex="1">
          <mxGeometry height="55" width="500" x="1130" y="235" as="geometry" />
        </mxCell>
        <mxCell id="P2_READ_SENSORS" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;rounded=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;" value="&lt;b&gt;ESP32 Đọc dữ liệu từ các cảm biến đầu vào:&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;Soil Moisture:&lt;/b&gt; Đọc ADC độ ẩm đất (0 - 4095)&lt;br/&gt; • &lt;b&gt;Light Sensor:&lt;/b&gt; Đọc cường độ ánh sáng môi trường (Lux)&lt;br/&gt; • &lt;b&gt;Air Sensor:&lt;/b&gt; Đọc chỉ số chất lượng không khí (AQI / PPM)&lt;br/&gt; • &lt;b&gt;Accelerometer:&lt;/b&gt; Đọc gia tốc 3 trục X, Y, Z (MPU6050)&lt;br/&gt; • &lt;b&gt;Temp &amp;amp; Pressure:&lt;/b&gt; Đọc nhiệt độ (°C) và áp suất môi trường (hPa)&lt;br/&gt; • &lt;b&gt;Water Level:&lt;/b&gt; Đọc mức nước trong bình chứa (ADC / Digital)&lt;br/&gt; • &lt;b&gt;Microphone:&lt;/b&gt; Lắng nghe liên tục tín hiệu âm thanh môi trường" vertex="1">
          <mxGeometry height="145" width="700" x="1030" y="315" as="geometry" />
        </mxCell>
        <mxCell id="P2_FILTER" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Lọc nhiễu &amp;amp; Tiền xử lý dữ liệu cảm biến:&lt;/b&gt;&lt;br/&gt; • Thuật toán lọc trung bình động (Moving Average Filter) làm mượt tín hiệu ADC&lt;br/&gt; • Tính vector gia tốc tổng hợp: &lt;i&gt;a = √(X² + Y² + Z²)&lt;/i&gt; (Phát hiện rung lắc / va đập)&lt;br/&gt; • Tính góc nghiêng chậu cây: &lt;i&gt;Tilt = atan2(Y, Z)&lt;/i&gt; (Phát hiện nghiêng đổ)" vertex="1">
          <mxGeometry height="85" width="660" x="1050" y="485" as="geometry" />
        </mxCell>
        <mxCell id="P2_VALID_DEC" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Dữ liệu cảm biến&lt;br/&gt;có hợp lệ không?&lt;/b&gt;&lt;br/&gt;(Trong dải đo vật lý)" vertex="1">
          <mxGeometry height="85" width="360" x="1200" y="595" as="geometry" />
        </mxCell>
        <mxCell id="P2_ERR_VAL" parent="1" style="rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;XỬ LÝ DỮ LIỆU DỊ THƯỜNG:&lt;/b&gt;&lt;br/&gt; • Đánh dấu cờ cảm biến lỗi &lt;code&gt;SENSOR_FAULT&lt;/code&gt;&lt;br/&gt; • Bỏ qua giá trị ngoại lai, giữ giá trị hợp lệ gần nhất&lt;br/&gt; • Kích hoạt icon cảnh báo lỗi trên OLED" vertex="1">
          <mxGeometry height="95" width="255" x="1565" y="690" as="geometry" />
        </mxCell>
        <mxCell id="P2_SAVE_RAM" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Lưu dữ liệu hợp lệ vào cấu trúc biến trong ESP32 RAM:&lt;/b&gt;&lt;br/&gt; Cập nhật biến toàn cục &lt;code&gt;SystemSensorsData&lt;/code&gt; (Sẵn sàng cung cấp cho các module)" vertex="1">
          <mxGeometry height="60" width="620" x="1070" y="805" as="geometry" />
        </mxCell>
        <mxCell id="P2_UPDATE_ENV" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Cập nhật trạng thái môi trường cây trồng:&lt;/b&gt;&lt;br/&gt; Ghi nhận vào biến &lt;code&gt;PlantEnvironmentState&lt;/code&gt; (Đánh giá sức khỏe sinh học cây)" vertex="1">
          <mxGeometry height="55" width="560" x="1100" y="890" as="geometry" />
        </mxCell>
        <mxCell id="P2_ANALYZE_CONDITIONS" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Phân tích &amp;amp; Đánh giá 6 Điều kiện môi trường cây trồng:&lt;/b&gt;&lt;br/&gt; 1. &lt;b&gt;Độ ẩm đất:&lt;/b&gt; Đất có đủ độ ẩm không? (So sánh ADC với ngưỡng quy ước 1100)&lt;br/&gt; 2. &lt;b&gt;Ánh sáng:&lt;/b&gt; Cường độ ánh sáng có phù hợp cho cây quang hợp không?&lt;br/&gt; 3. &lt;b&gt;Nhiệt độ &amp;amp; Áp suất:&lt;/b&gt; Có quá nóng (&amp;gt;35°C) hoặc quá lạnh (&amp;lt;15°C) không?&lt;br/&gt; 4. &lt;b&gt;Chất lượng không khí:&lt;/b&gt; Có bất thường không? (Khói, khí gas ô nhiễm)&lt;br/&gt; 5. &lt;b&gt;Bình chứa nước:&lt;/b&gt; Còn đủ lượng nước an toàn để thực hiện tưới không?&lt;br/&gt; 6. &lt;b&gt;Vị trí chậu cây:&lt;/b&gt; Có bị rung lắc mạnh hoặc nghiêng đổ bất thường không? (MPU6050)" vertex="1">
          <mxGeometry height="145" width="700" x="1030" y="970" as="geometry" />
        </mxCell>
        <mxCell id="P2_DISPATCHER" parent="1" style="rounded=1;arcSize=6;fillColor=#0F766E;strokeColor=#115E59;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=11.5;shadow=1;" value="&lt;b&gt;BỘ ĐIỀU PHỐI DỮ LIỆU TRUNG TÂM ESP32 (DATA DISPATCHER):&lt;/b&gt;&lt;br/&gt; Phân phối tức thời dữ liệu sạch và các cờ phân tích tới các phân hệ:&lt;br/&gt; ➔ &lt;b&gt;Phân hệ 3 (Tưới tự động):&lt;/b&gt; Cung cấp Soil ADC và Water Level để quyết định tưới&lt;br/&gt; ➔ &lt;b&gt;Phân hệ 4 (Biểu cảm OLED):&lt;/b&gt; Cung cấp Temp, Light, Soil, Tilt để chọn cảm xúc&lt;br/&gt; ➔ &lt;b&gt;Phân hệ 6 (Cloud &amp;amp; Mobile App):&lt;/b&gt; Cung cấp toàn bộ Telemetry đóng gói JSON" vertex="1">
          <mxGeometry height="110" width="720" x="1020" y="1145" as="geometry" />
        </mxCell>
        <mxCell id="P2_WAIT_NEXT" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Chờ chu kỳ đo tiếp theo (Timer Delay T = 2 - 5 giây)&lt;/b&gt;&lt;br/&gt;Đảm bảo hệ thống vận hành định kỳ liên tục" vertex="1">
          <mxGeometry height="55" width="460" x="1150" y="1285" as="geometry" />
        </mxCell>
