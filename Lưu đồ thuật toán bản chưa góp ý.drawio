<mxfile host="app.diagrams.net" agent="Antigravity/ESP32-AI-Flowchart">
  <diagram id="diagram_esp32_smart_plant_flowchart" name="Lưu đồ thuật toán Hệ thống trồng cây thông minh ESP32 + AI">
    <mxGraphModel dx="2939" dy="1988" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2860" pageHeight="3240" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TOP_HEADER" parent="1" style="rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#FFFFFF;align=center;verticalAlign=middle;html=1;shadow=1;" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;     &lt;span style=&quot;font-size:22px; font-weight:800; color:#FFFFFF; letter-spacing:0.5px;&quot;&gt;HỆ THỐNG GIÁM SÁT MÔI TRƯỜNG VÀ CHĂM SÓC CÂY TRỒNG THÔNG MINH SỬ DỤNG ESP32 KẾT HỢP AI CHATBOT&lt;/span&gt;&lt;br/&gt;     &lt;span style=&quot;font-size:13.5px; font-weight:600; color:#38BDF8; letter-spacing:0.3px;&quot;&gt;LƯU ĐỒ THUẬT TOÁN KỸ THUẬT TỔNG THỂ (ESP32 EMBEDDED CONTROL &amp;amp; CLOUD AI MULTI-SUBSYSTEM FLOWCHART)&lt;/span&gt;&lt;br/&gt;     &lt;span style=&quot;font-size:11.5px; color:#CBD5E1;&quot;&gt;Bộ điều khiển trung tâm: &lt;b&gt;ESP32 Dual-Core&lt;/b&gt; | Cảm biến: &lt;b&gt;Độ ẩm đất (ADC), Ánh sáng, Không khí (AQI), Gia tốc (MPU6050), Nhiệt độ &amp;amp; Áp suất, Mực nước, Mic&lt;/b&gt; | Đầu ra: &lt;b&gt;Bơm 5V, 2x OLED 0.96&amp;quot;, Loa&lt;/b&gt; | Nền tảng: &lt;b&gt;Wi-Fi, Cloud DB, AI Chatbot (STT/LLM/TTS), Mobile App&lt;/b&gt;&lt;/span&gt;   &lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="2750" x="50" y="35" as="geometry" />
        </mxCell>
        <mxCell id="P1_CONTAINER" parent="1" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;dashed=0;html=1;shadow=0;" value="" vertex="1">
          <mxGeometry height="1550" width="830" x="50" y="170" as="geometry" />
        </mxCell>
        <mxCell id="P1_HEADER" parent="1" style="rounded=1;arcSize=4;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;html=1;" value="PHÂN HỆ 1: KHỞI TẠO HỆ THỐNG (SYSTEM INITIALIZATION)" vertex="1">
          <mxGeometry height="45" width="830" x="50" y="170" as="geometry" />
        </mxCell>
        <mxCell id="P1_START" parent="1" style="rounded=1;arcSize=50;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=12;shadow=1;" value="&lt;b&gt;BẮT ĐẦU (START)&lt;/b&gt;&lt;br/&gt;Cấp nguồn cho toàn hệ thống (5V DC Adapter / Pin)" vertex="1">
          <mxGeometry height="55" width="420" x="255" y="235" as="geometry" />
        </mxCell>
        <mxCell id="P1_BOOT" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;ESP32 Khởi động (Bootloader)&lt;/b&gt;&lt;br/&gt;Nạp cấu hình Flash, khởi tạo hệ điều hành thời gian thực FreeRTOS" vertex="1">
          <mxGeometry height="55" width="480" x="225" y="315" as="geometry" />
        </mxCell>
        <mxCell id="P1_PERIPH" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Khởi tạo các Chân GPIO &amp;amp; Giao tiếp Ngoại vi cần thiết:&lt;/b&gt;&lt;br/&gt; • &lt;b&gt;GPIO / PWM:&lt;/b&gt; Chân điều khiển Relay/MOSFET Bơm 5V, Status LED&lt;br/&gt; • &lt;b&gt;ADC 12-bit (0 - 4095):&lt;/b&gt; Cảm biến độ ẩm đất, Cảm biến mực nước&lt;br/&gt; • &lt;b&gt;I2C Bus:&lt;/b&gt; 2x OLED 0.96&amp;quot; (0x3C, 0x3D), BMP280, MPU6050, BH1750&lt;br/&gt; • &lt;b&gt;I2S / DAC / UART:&lt;/b&gt; Microphone INMP441, Mạch khuếch đại Loa Audio" vertex="1">
          <mxGeometry height="95" width="560" x="185" y="395" as="geometry" />
        </mxCell>
        <mxCell id="P1_SENSORS" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Khởi tạo &amp;amp; Cấu hình 6 Cảm biến đầu vào:&lt;/b&gt;&lt;br/&gt; 1. Cảm biến độ ẩm đất (Soil Moisture ADC)&lt;br/&gt; 2. Cảm biến ánh sáng (Light Sensor Lux)&lt;br/&gt; 3. Cảm biến chất lượng không khí (Air Sensor AQI/PPM)&lt;br/&gt; 4. Cảm biến gia tốc MPU6050 (Trục X, Y, Z)&lt;br/&gt; 5. Cảm biến nhiệt độ &amp;amp; áp suất (BMP280 / BME280)&lt;br/&gt; 6. Cảm biến mực nước bình chứa (Water Level ADC/Digital)&lt;br/&gt; &lt;i&gt;+ Microphone thu nhận âm thanh giọng nói&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="560" x="185" y="515" as="geometry" />
        </mxCell>
        <mxCell id="P1_ACTUATORS" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Khởi tạo 4 Thiết bị đầu ra (Cơ cấu chấp hành):&lt;/b&gt;&lt;br/&gt; 1. OLED 0.96&amp;quot; số 1 (Hiển thị Mắt Trái - Địa chỉ I2C 0x3C)&lt;br/&gt; 2. OLED 0.96&amp;quot; số 2 (Hiển thị Mắt Phải - Địa chỉ I2C 0x3D)&lt;br/&gt; 3. Mạch khuếch đại âm thanh &amp;amp; Loa (Phát âm thanh AI Chatbot)&lt;br/&gt; 4. Relay / MOSFET điều khiển Bơm mini 5V (Trạng thái mặc định: &lt;b&gt;OFF&lt;/b&gt;)" vertex="1">
          <mxGeometry height="90" width="560" x="185" y="670" as="geometry" />
        </mxCell>
        <mxCell id="P1_CHECK_HW" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Các cảm biến &amp;amp; thiết bị&lt;br/&gt;có hoạt động bình thường?&lt;/b&gt;&lt;br/&gt;(Self-test phần cứng)" vertex="1">
          <mxGeometry height="85" width="360" x="285" y="785" as="geometry" />
        </mxCell>
        <mxCell id="P1_HW_ERR" parent="1" style="rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;XỬ LÝ LỖI PHẦN CỨNG:&lt;/b&gt;&lt;br/&gt; • Ghi nhận mã lỗi cảm biến vào Flash/EEPROM&lt;br/&gt; • OLED hiển thị icon cảnh báo [!]&lt;br/&gt; • Gửi log cảnh báo lỗi lên Cloud (nếu có mạng)&lt;br/&gt; • Duy trì giám sát các cảm biến còn hoạt động được (Degraded Mode)" vertex="1">
          <mxGeometry height="110" width="255" x="605" y="890" as="geometry" />
        </mxCell>
        <mxCell id="P1_INIT_WIFI" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Khởi tạo kết nối Wi-Fi Station (ESP32 Wi-Fi Stack)&lt;/b&gt;&lt;br/&gt;Thử kết nối Access Point theo SSID/Password cấu hình (Timeout: 10s)" vertex="1">
          <mxGeometry height="60" width="540" x="195" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="P1_WIFI_DEC" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#854D0E;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Wi-Fi có kết nối&lt;br/&gt;thành công không?&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="295" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="P1_WIFI_YES" parent="1" style="rounded=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;align=center;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;" value="&lt;b&gt;NHÁNH YES: Chế độ Online (isOnline = TRUE)&lt;/b&gt;&lt;br/&gt; • Đồng bộ thời gian thực qua máy chủ NTP&lt;br/&gt; • Kết nối Cloud Server / Database (MQTT/HTTPS)&lt;br/&gt; • Đồng bộ cấu hình ngưỡng và trạng thái thiết bị ban đầu" vertex="1">
          <mxGeometry height="90" width="360" x="75" y="1215" as="geometry" />
        </mxCell>
        <mxCell id="P1_WIFI_NO" parent="1" style="rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;verticalAlign=middle;html=1;fontSize=11;" value="&lt;b&gt;NHÁNH NO: Chế độ Offline (isOnline = FALSE)&lt;/b&gt;&lt;br/&gt; • OLED hiển thị biểu tượng Offline [Wi-Fi X]&lt;br/&gt; • Chuyển sang chế độ tự hành cục bộ&lt;br/&gt; • Đảm bảo ESP32 tự điều khiển tưới &amp;amp; OLED độc lập" vertex="1">
          <mxGeometry height="90" width="370" x="485" y="1215" as="geometry" />
        </mxCell>
        <mxCell id="P1_INIT_DONE" parent="1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;html=1;fontSize=11.5;" value="&lt;b&gt;Khởi tạo hoàn tất! Thiết lập bộ định thời (FreeRTOS Timers)&lt;/b&gt;&lt;br/&gt;Kích hoạt các Task định kỳ: Đọc cảm biến, Tưới tự động, Hiển thị OLED" vertex="1">
          <mxGeometry height="65" width="540" x="195" y="1335" as="geometry" />
        </mxCell>
        <mxCell id="P1_GOTO_LOOP" parent="1" style="rounded=1;arcSize=50;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;html=1;fontSize=12;shadow=1;" value="&lt;b&gt;CHUYỂN ĐẾN VÒNG LẶP CHÍNH (MAIN LOOP)&lt;/b&gt;&lt;br/&gt;➔ Bàn giao quyền điều khiển sang &lt;b&gt;PHÂN HỆ 2&lt;/b&gt;" vertex="1">
          <mxGeometry height="65" width="460" x="235" y="1430" as="geometry" />
        </mxCell>
