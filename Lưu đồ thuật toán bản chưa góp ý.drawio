        <mxCell id="P3_HEADER" parent="1" style="rounded=1;arcSize=4;fillColor=#15803D;strokeColor=#166534;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;html=1;" value="PHÂN HỆ 3: THUẬT TOÁN TƯỚI CÂY TỰ ĐỘNG (INTELLIGENT WATERING ENGINE)" vertex="1">
          <mxGeometry height="45" width="920" x="1880" y="170" as="geometry" />
