        <mxCell id="P3_SPECIAL_REQUIREMENTS" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;" value="&lt;b&gt;YÊU CẦU ĐẶC BIỆT CỦA THUẬT TOÁN TƯỚI NƯỚC:&lt;/b&gt;&lt;br/&gt; ✓ &lt;b&gt;Chu kỳ chuẩn 3s:&lt;/b&gt; Bơm chỉ được hoạt động theo từng xung 3 giây định lượng.&lt;br/&gt; ✓ &lt;b&gt;Bắt buộc tắt bơm:&lt;/b&gt; Sau mỗi 3s phải tắt bơm và chờ 1-2s ngấm trước khi đo lại.&lt;br/&gt; ✓ &lt;b&gt;Chống tưới liên tục:&lt;/b&gt; Tuyệt đối không để bơm chạy liên tục trong vòng lặp vô hạn.&lt;br/&gt; ✓ &lt;b&gt;Bảo vệ cạn nước:&lt;/b&gt; Phải kiểm tra cảm biến mực nước trước mỗi lần bật bơm.&lt;br/&gt; ✓ &lt;b&gt;Hoạt động Offline:&lt;/b&gt; Mất kết nối Internet, tưới tự động vẫn chạy 100% bình thường.&lt;br/&gt; ✓ &lt;b&gt;Cơ chế an toàn tối đa:&lt;/b&gt; Giới hạn 5 chu kỳ liên tiếp để phát hiện hỏng cảm biến." vertex="1">
          <mxGeometry height="140" width="640" x="1980" y="1540" as="geometry" />
        </mxCell>
